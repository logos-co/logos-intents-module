module intents_presenter {
  version "1.0.0"
  description "Frontends only: the presenter's side of intents_module. Every method but claim needs the secret claim returned."
  depends []

  method claim() -> tstr
  method next_work(secret: tstr) -> tstr
  method answer(secret: tstr, work_id: tstr, answer_json: tstr) -> tstr
  method set_installed(secret: tstr, packages_json: tstr) -> tstr
  method declare_shell(secret: tstr, shell_json: tstr) -> tstr
  method shell_request(secret: tstr, intent: tstr, params_json: tstr, as_link: bool) -> tstr

  event work_available(counter: uint)
}
